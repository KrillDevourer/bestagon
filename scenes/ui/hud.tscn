; The level-up toast. Sits just ABOVE the XP bar rather than centre-screen: it
; fires on most level-ups, and anything that frequent in the middle of the arena
; becomes something the player learns to look past. Next to the level number is
; where the eye already goes when the bar fills.
[node name="LevelToast" type="Label" parent="."]
unique_name_in_owner = true
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 8.0
offset_top = -40.0
offset_right = 260.0
offset_bottom = -24.0
grow_vertical = 0
theme_override_colors/font_color = Color(0.72, 1, 0.86, 1)
theme_override_font_sizes/font_size = 11
text = ""

