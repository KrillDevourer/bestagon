[gd_scene load_steps=7 format=3]

[ext_resource type="Script" path="res://scenes/ui/hud.gd" id="1_hud"]
[ext_resource type="Script" path="res://scenes/ui/target_markers.gd" id="2_marks"]

; Neon HUD. Colour law (BRIEF.md §5): the HUD is the player's own instrument,
; so it lives in the cyan family — the magenta/orange band stays reserved for
; things that can hurt you, and XP echoes the green-cyan of the gems it counts.

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bg"]
bg_color = Color(0.04, 0.05, 0.11, 0.72)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.16, 0.21, 0.38, 1)
corner_radius_top_left = 2
corner_radius_top_right = 2
corner_radius_bottom_right = 2
corner_radius_bottom_left = 2

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_hp"]
bg_color = Color(0.42, 0.97, 0.96, 1)
corner_radius_top_left = 2
corner_radius_top_right = 2
corner_radius_bottom_right = 2
corner_radius_bottom_left = 2

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_xp"]
bg_color = Color(0.45, 1, 0.72, 1)
corner_radius_top_left = 2
corner_radius_top_right = 2
corner_radius_bottom_right = 2
corner_radius_bottom_left = 2

; The boss bar is the ONE piece of HUD allowed out of the cyan family. It
; represents the thing trying to kill you, so it wears the hostile band — and
; review finding 3 was that the run's win condition had no progress readout at
; all: 1800 HP with a shard-detach at 50% as the only feedback in the fight.
; Playtest 2026-08-02: "make the hp bar and name a bit smaller and with a more
; neon tech vibe". Smaller (300x8 -> 220x5, 13px label -> 10px) and rebuilt as a
; lit strip rather than a filled rectangle: a near-black channel with a thin
; magenta rule and a bloom under the fill, so it reads as an INSTRUMENT showing a
; hostile readout instead of a progress bar borrowed from a productivity app.
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_boss"]
bg_color = Color(1, 0.35, 0.72, 1)
shadow_color = Color(1, 0.35, 0.72, 0.45)
shadow_size = 3

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bossbg"]
bg_color = Color(0.06, 0.02, 0.07, 0.85)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.62, 0.18, 0.44, 1)

[node name="Hud" type="CanvasLayer"]
script = ExtResource("1_hud")

; Edge arrows for things the player must kill and cannot see. FULL RECT and
; MOUSE_FILTER_IGNORE: it covers the whole screen to draw on it and must never
; intercept a click. Listed FIRST so every readable element draws over it --
; an arrow is a hint, and a hint may never sit on top of the HP bar.
[node name="TargetMarkers" type="Control" parent="."]
unique_name_in_owner = true
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
script = ExtResource("2_marks")

[node name="BossPanel" type="VBoxContainer" parent="."]
