; FOUR phases, where the Prism has two.
;
; The FIRST threshold is 1.0 and is deliberately unreachable by damage: phase 1
; ends when the opening pair of Prisms dies, and the boss is invulnerable for the
; whole of it, so its HP never moves. The director calls escorts_cleared() to end
; it. 1.0 rather than a real number so that if the shield is ever dropped in
; phase 1 by some future path, the very next hit advances the fight instead of
; leaving it stuck in its opening stance.
; Then: mirroring the player below 100%, denser below 60%, last stand below 25%.
[node name="Nogaxeh" type="CharacterBody2D" groups=["enemies"]]
collision_layer = 2
collision_mask = 19
script = ExtResource("1_ng")
boss_stats = ExtResource("4_stats")
phase_thresholds = PackedFloat32Array(1.0, 0.6, 0.25)
telegraph = 0.78
p1_interval = 2.2
p2_interval = 1.25
shard_orbit = 112.0
bolt_speed = 118.0
; SIX SIDES, and this is the ONLY thing in the game besides the player allowed
; them. gen_assets.py reserves the hexagon -- "nothing else may claim six sides"
; -- and Nogaxeh breaks that rule exactly once, here, at 10:00, because the break
; IS the reveal. The sprite is boss_mirror.png, a hollow hexagon; the solid has to
; agree with it or the reveal lands on a shape that is not the one being revealed.
solid_sides = 6

; Drawn only while dashing. top_level so it stays in world space instead of
; being dragged along by the boss it belongs to.
[node name="Trail" type="Line2D" parent="."]
top_level = true
z_index = -2
width = 9.0
gradient = SubResource("Gradient_mirror")
joint_mode = 2
begin_cap_mode = 2
end_cap_mode = 2
antialiased = true

[node name="Visual" type="Sprite2D" parent="."]
material = SubResource("ShaderMaterial_flash")
texture = ExtResource("2_tex")

; The shield membrane. Hidden until phase 3, then fills the hollow ring: the cell
; closes. Behind the body so the ring still reads as the boss's own silhouette.
[node name="Membrane" type="Sprite2D" parent="."]
z_index = -1
texture = ExtResource("5_shield")

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
shape = SubResource("RectangleShape2D_ng")
