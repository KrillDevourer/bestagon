[node name="Main" type="Node2D"]
script = ExtResource("1_main")

; THE ARENA IS RENDERED, NOT DRAWN DIRECTLY. Everything below WorldViewport is
; the same 2D game it has always been; it just renders off-screen so ArenaStage
; can put it on a floor in 3D and lean the camera over it for a boss.
;
; UI STAYS OUT HERE ON PURPOSE. Hud, LevelUpPanel, PausePanel, GameOver, Victory
; and TrueEnding are all CanvasLayer, so out here they render to the root
; viewport in screen space and stay flat while the world tilts. Inside the
; SubViewport they would be painted onto the floor and lean with it, which puts
; the pause menu on a slope.
;
; Spawner and RunDirector are pure logic with no position, so they have no
; reason to be inside a viewport.
[node name="ArenaStage" type="Node3D" parent="."]
script = ExtResource("17_stage")

[node name="WorldViewport" type="SubViewport" parent="ArenaStage"]
size = Vector2i(640, 360)
render_target_update_mode = 3

